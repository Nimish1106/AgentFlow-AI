# Application
APP_NAME=AgentOps AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (async driver required)
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops

# Redis
REDIS_URL=redis://localhost:6379/0
WORKFLOW_STREAM=agentops:workflow_queue

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# Docker Compose (postgres container bootstrap)
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops

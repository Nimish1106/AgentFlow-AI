# Application
APP_NAME=AgentFlow AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (async driver required)
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# Redis
REDIS_URL=redis://localhost:6379/0
WORKFLOW_STREAM=agentflow:workflow_queue

# Enterprise MCP Server (use http://localhost:8001 outside Docker)
MCP_SERVER_URL=http://enterprise-mcp:8000
MCP_TOOL_TIMEOUT_SECONDS=10.0

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# Docker Compose (postgres container bootstrap)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow
POSTGRES_DB=agentflow

# RAG / Qdrant (use http://localhost:6333 outside Docker)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.6
KNOWLEDGE_DOCS_DIR=docs/knowledge
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Risk Engine + HITL governance (SRS §38, §39)
HITL_REFUND_THRESHOLD=1000.0
HITL_CONFIDENCE_THRESHOLD=0.6

# Queue dispatcher (runs the LangGraph workflow; scale by giving each replica
# a distinct DISPATCHER_CONSUMER_NAME)
DISPATCHER_CONSUMER_GROUP=agentflow-dispatcher
DISPATCHER_CONSUMER_NAME=dispatcher-1
DISPATCHER_BLOCK_MS=5000
# Optional outbound delivery of the final response. Empty = disabled; a failed
# webhook logs and continues, it never fails the workflow.
DISPATCH_WEBHOOK_URL=
DISPATCH_WEBHOOK_TIMEOUT_SECONDS=5.0

# Operations dashboard (Phase 7). Origins allowed to call the API from a
# browser - comma separated, never a wildcard (SRS §43). Port 3000 is the
# containerised dashboard; 5173 is the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Observability (SRS §42). Off by default; no collector is needed to run the
# system. Enabled with no endpoint set, spans print to the container logs.
# Point OTEL_EXPORTER_OTLP_ENDPOINT at any OTLP/HTTP collector to export them,
# e.g. http://jaeger:4318 or http://otel-collector:4318.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentflow
OTEL_EXPORTER_OTLP_ENDPOINT=
